# Configure an OpenAI-compatible provider. Do not commit credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Pass model IDs explicitly on the command line. No model or alternate key is selected automatically.
# For another OpenAI-compatible provider, replace OPENAI_BASE_URL and set its key.
# Use --api-key-env NAME if the key is stored in another environment variable.
